# The pi workflow requires credentials. Canvas mode has a local demo without them.
# Set these to the endpoint, key, and model supplied by your API provider.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Most OpenAI-compatible providers support Chat Completions. Use responses only
# when your provider explicitly supports the Responses API.
LLM_API_STYLE=chat-completions
PORT=4174

# pi develops each video in an independent template project.
VIDEO_ENGINE=pi
# Optional absolute executable path; otherwise find pi on PATH.
# PI_BIN=/Users/your-name/.local/bin/pi
# Match the context window supported by the configured model.
PI_CONTEXT_WINDOW=128000
# Enable only if the configured model/provider supports actual image input.
PI_INPUT_IMAGES=false
# Frames are sampled sequentially. Full-video rendering defaults to one worker
# to reduce memory pressure; optional values: 1–4.
VIDEO_RENDER_CONCURRENCY=1

# Optional budget per model call, including reasoning and visible output.
# Large videos are generated in modules rather than a single answer.
LLM_MAX_OUTPUT_TOKENS=48000
# Optional; omit to retain the provider default. Use only values supported by it.
# DeepSeek supports none/low/high/max. Responses uses reasoning.effort.
# LLM_REASONING_EFFORT=low
LLM_REQUEST_TIMEOUT_MS=300000
